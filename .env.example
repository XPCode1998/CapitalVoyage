APP_NAME=CapitalVoyage
APP_ENV=development
DATABASE_URL=sqlite:///../data/capital_voyage.db
TIMEZONE=Asia/Shanghai
MARKET_PROVIDER=akshare
MARKET_POLL_INTERVAL_SECONDS=15
MARKET_QUOTE_STALE_SECONDS=30
DEFAULT_CAPITAL=500000
DEFAULT_SLOT_COUNT=10
DEFAULT_SLOT_AMOUNT=50000
DEFAULT_TARGET_RETURN=0.02
NEAR_RETURN_BUFFER=0.002
LONG_VOYAGE_DAYS=10
RETURN_PRICE_MODE=BID1

BUY_COMMISSION_RATE=0.0003
SELL_COMMISSION_RATE=0.0003
MINIMUM_BUY_COMMISSION=5
MINIMUM_SELL_COMMISSION=5
OTHER_BUY_FEE_RATE=0
OTHER_SELL_FEE_RATE=0
NOTIFICATION_PROVIDER=none
NOTIFICATION_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=30
SCHEDULER_ENABLED=true
